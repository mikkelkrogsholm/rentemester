# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# Separate candidate until Rust cutover and reviewed release gates pass.
ARG RUST_IMAGE=rust:1.94.1-slim-bookworm@sha256:cf9dd0ec73e75f827fe59123fff9dc65af1a1c8363c3c31ee8d7f8ad0b6a5fb2
ARG WEB_IMAGE=oven/bun:1.4.0-slim@sha256:e0ee68d16ccb9927bf02aa7dd8fd4bf3369ee6d46da04faa72b05ce8bfd135f6
ARG RUNTIME_IMAGE=debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

FROM ${WEB_IMAGE} AS web
WORKDIR /build
COPY package.json bun.lock bunfig.toml ./
COPY app/package.json app/bunfig.toml ./app/
RUN bun install --frozen-lockfile
COPY app/ ./app/
COPY DESIGN.md ./
COPY scripts/design-tokens.ts ./scripts/design-tokens.ts
COPY src/design ./src/design
COPY src/core/access-permissions.ts ./src/core/access-permissions.ts
COPY crates/rentemester-desktop/src/design_tokens.rs ./crates/rentemester-desktop/src/design_tokens.rs
RUN bun run cockpit:build

FROM ${RUST_IMAGE} AS rust-toolchain
FROM rust-toolchain AS rust-build
ARG TARGETARCH
WORKDIR /source
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo/ ./.cargo/
COPY crates/ ./crates/
COPY vendor/ ./vendor/
COPY src/core/migrations/ ./src/core/migrations/
COPY src/core/workspace-migrations/ ./src/core/workspace-migrations/
COPY scripts/rust/cargo-guard.sh scripts/rust/cargo-guard.py ./scripts/rust/
COPY scripts/rust/pdf-worker/artifacts.json ./scripts/rust/pdf-worker/artifacts.json
ENV CARGO_HOME=/build/cargo-home CARGO_TARGET_DIR=/build/target RENTEMESTER_CARGO_CACHE=/build/target CARGO_INCREMENTAL=0
# One serialized, guarded cache per target architecture.
RUN --mount=type=cache,id=rentemester-rust-1.94.1-${TARGETARCH},target=/build,sharing=locked \
    umask 077 && scripts/rust/cargo-guard.sh cargo build --release --locked -p rentemester-server -p rentemester-cli -p rentemester-mcp -p rentemester-pdf-worker \
    && mkdir /out \
    && cp /build/target/release/rentemester-server /build/target/release/rentemester-rust /build/target/release/rentemester-mcp /build/target/release/rentemester-pdf-worker /out/

FROM ${RUNTIME_IMAGE} AS runtime-base
COPY --from=rust-toolchain /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
# Dated GPG-verified snapshot; TLS verification stays on.
RUN printf '' > /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261005T000000Z bookworm main' > /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && apt-get clean

FROM runtime-base AS pdf-artifact
ARG TARGETARCH
RUN apt-get install -y --no-install-recommends python3 && apt-get clean
COPY scripts/rust/pdf-worker/ /fetch/
RUN case "$TARGETARCH" in amd64) artifact=pdfium-linux-x64.tgz ;; arm64) artifact=pdfium-linux-arm64.tgz ;; *) exit 2 ;; esac \
    && python3 /fetch/fetch.py --artifact "$artifact" --destination /pdfium

FROM runtime-base AS runtime
ARG RENTEMESTER_GIT_COMMIT
ARG RENTEMESTER_VERSION
ARG SOURCE_DATE_EPOCH
ARG RENTEMESTER_SOURCE_DIRTY=true
LABEL org.opencontainers.image.title="Rentemester Rust candidate" \
    org.opencontainers.image.source="https://github.com/mikkelkrogsholm/rentemester" \
    org.opencontainers.image.revision="${RENTEMESTER_GIT_COMMIT}" \
    org.opencontainers.image.version="${RENTEMESTER_VERSION}" \
    org.rentemester.runtime="rust" org.rentemester.runtime.rust.version="1.94.1" \
    org.rentemester.source.dirty="${RENTEMESTER_SOURCE_DIRTY}"
COPY --from=rust-build --chmod=0555 /out/ /opt/rentemester/bin/
COPY --from=web --chmod=0555 /build/app/dist/ /opt/rentemester/web/
COPY --from=pdf-artifact --chmod=0555 /pdfium/ /opt/rentemester/bin/pdfium/
COPY --chmod=0555 scripts/release/rust-entrypoint.sh /usr/local/bin/rentemester-entrypoint
RUN test -n "$RENTEMESTER_VERSION" \
    && printf '%s' "$RENTEMESTER_GIT_COMMIT" | grep -Eq '^[0-9a-f]{40}$' \
    && test -n "$SOURCE_DATE_EPOCH" \
    && mkdir -p /state /config && chown 10001:10001 /state && chmod 0700 /state \
    && dpkg-query -W > /opt/rentemester/debian-packages.txt \
    && for file in /opt/rentemester/bin/rentemester-* /opt/rentemester/bin/pdfium/lib/libpdfium.so; do \
         ldd "$file" >> /opt/rentemester/linked-libraries.txt; \
       done \
    && ! grep -q 'not found' /opt/rentemester/linked-libraries.txt
ENV RENTEMESTER_CONFIG=/config/server.json RENTEMESTER_ORIGIN=http://127.0.0.1:4319
WORKDIR /opt/rentemester
EXPOSE 4319
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl --noproxy '*' --fail --silent --max-time 4 http://127.0.0.1:4319/api/health | grep -q '"workspaceReady":true'
STOPSIGNAL SIGTERM
ENTRYPOINT ["rentemester-entrypoint"]
CMD []
