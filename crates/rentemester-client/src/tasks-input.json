{
  "list": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "companySlugs": {
        "maxItems": 200,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "includeArchived": {
        "type": "boolean"
      },
      "status": {
        "type": "string",
        "enum": [
          "open",
          "in_progress",
          "waiting",
          "done"
        ]
      },
      "type": {
        "type": "string",
        "enum": [
          "ad_hoc",
          "routine",
          "obligation"
        ]
      },
      "search": {
        "type": "string",
        "maxLength": 240
      },
      "assigneeId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "from": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "ISO calendar date YYYY-MM-DD; dates are validated again by the domain."
      },
      "to": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "ISO calendar date YYYY-MM-DD; dates are validated again by the domain."
