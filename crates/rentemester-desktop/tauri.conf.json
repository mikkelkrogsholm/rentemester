{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rentemester",
  "version": "0.1.0",
  "identifier": "dk.rentemester.desktop",
  "build": {
    "frontendDist": "launcher"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        "launcher"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "launcher/icon.png",
      "../../assets/branding/rentemester-app-icon-v1.icns"
    ]
  }
}
