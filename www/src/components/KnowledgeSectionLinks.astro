---
import { attributes as sx } from "../../.stylex/site-stylex";
import { VIDEN_SECTIONS } from "../site-map";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const normalizedPath = pathname === "/" ? "/" : pathname.replace(/\/$/, "");
const currentSection = VIDEN_SECTIONS.find((section) =>
  section.links.some((link) => link.href === normalizedPath),
);
const siblingLinks = currentSection?.links.filter((link) => link.href !== normalizedPath) ?? [];
const links = siblingLinks.slice(0, 8);
---

{currentSection && links.length > 0 && (
  <aside {...sx.components_KnowledgeSectionLinks_aside1}>
    <div {...sx.components_KnowledgeSectionLinks_div2}>
      <div {...sx.components_Footer_div10}>
        Mere om {currentSection.title.toLocaleLowerCase("da-DK")}
      </div>
      <div {...sx.components_KnowledgeSectionLinks_div3}>
        {links.map((link) => (
          <a
            href={link.href}
            {...sx.components_KnowledgeSectionLinks_a4}
          >
            {link.label} →
          </a>
        ))}
      </div>
      <a href="/viden" {...sx.components_KnowledgeSectionLinks_a5}>
        Alle vidensider →
      </a>
    </div>
  </aside>
)}
