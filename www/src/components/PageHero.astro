---
import { attributes as sx } from "../../.stylex/site-stylex";
export interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section {...sx.components_PageHero_section1}>
  <div {...sx.components_PageHero_div2}>
    <div {...sx.components_PageHero_div3}></div>
  </div>
  <div {...sx.components_PageHero_div4}>
    <div {...sx.components_PageHero_div5}>
      {eyebrow && (
        <div {...sx.components_PageHero_div6}>{eyebrow}</div>
      )}
      <h1 {...sx.components_PageHero_h17}>
        {title}
      </h1>
      {lead && (
        <p {...sx.components_PageHero_p8}>{lead}</p>
      )}
    </div>
  </div>
</section>
