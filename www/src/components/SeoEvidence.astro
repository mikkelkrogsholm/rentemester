---
import { attributes as sx } from "../../.stylex/site-stylex";
import { SITE } from "../consts";

type LinkItem = {
  href: string;
  label: string;
  external?: boolean;
};

export interface Props {
  published?: string;
  updated?: string;
  reviewed?: string;
  status?: string;
  sources?: LinkItem[];
  related?: LinkItem[];
}

const {
  published = "2026-05-19",
  updated = "2026-05-19",
  reviewed = SITE.author,
  status = "QA-gennemgået mod kode, tests og relevante kilder.",
  sources = [],
  related = [],
} = Astro.props;
---

<aside {...sx.components_SeoEvidence_aside1}>
  <p {...sx.components_SeoEvidence_p2}>
    Af <a href="/om" rel="author" {...sx.components_SeoEvidence_a3}>{SITE.author}</a>
    · Publiceret <time {...sx.components_SeoEvidence_time4} datetime={published}>{published}</time>
    · Opdateret <time {...sx.components_SeoEvidence_time4} datetime={updated}>{updated}</time>
  </p>
  <div {...sx.components_SeoEvidence_div5}>
    <div {...sx.components_SeoEvidence_div6}>
      <div {...sx.components_SeoEvidence_div7}>Kvalitetssikring</div>
      <dl {...sx.components_SeoEvidence_dl8}>
        <div {...sx.components_SeoEvidence_div9}>
          <dt {...sx.components_SeoEvidence_dt10}>Udgivet: </dt>
          <dd {...sx.components_SeoEvidence_dd11}><time {...sx.components_SeoEvidence_time4} datetime={published}>{published}</time></dd>
        </div>
        <div {...sx.components_SeoEvidence_div9}>
          <dt {...sx.components_SeoEvidence_dt10}>Sidst opdateret: </dt>
          <dd {...sx.components_SeoEvidence_dd11}><time {...sx.components_SeoEvidence_time4} datetime={updated}>{updated}</time></dd>
        </div>
        <div {...sx.components_SeoEvidence_div9}>
          <dt {...sx.components_SeoEvidence_dt10}>Forfatter: </dt>
          <dd {...sx.components_SeoEvidence_dd11} itemprop="author" itemscope itemtype="https://schema.org/Person">
            <span {...sx.components_SeoEvidence_span12} itemprop="name">{SITE.author}</span>
          </dd>
        </div>
        <div {...sx.components_SeoEvidence_div9}>
          <dt {...sx.components_SeoEvidence_dt10}>Fagligt gennemgået af: </dt>
          <dd {...sx.components_SeoEvidence_dd11}>{reviewed}</dd>
        </div>
        <div {...sx.components_SeoEvidence_div9}>
          <dt {...sx.components_SeoEvidence_dt10}>Status: </dt>
          <dd {...sx.components_SeoEvidence_dd11}>{status}</dd>
        </div>
      </dl>
    </div>

    <div {...sx.components_SeoEvidence_div13}>
      {sources.length > 0 && (
        <div {...sx.components_SeoEvidence_div6}>
          <div {...sx.components_SeoEvidence_div14}>Kilder</div>
          <ul {...sx.components_SeoEvidence_ul15}>
            {sources.map((source) => (
              <li {...sx.components_SeoEvidence_li16}>
                <a {...sx.components_SeoEvidence_a17} href={source.href} rel={source.external ? "noopener" : undefined} target={source.external ? "_blank" : undefined}>
                  {source.label}{source.external ? " ↗" : ""}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {related.length > 0 && (
        <div {...sx.components_SeoEvidence_div6}>
          <div {...sx.components_SeoEvidence_div14}>Relateret</div>
          <ul {...sx.components_SeoEvidence_ul15}>
            {related.map((link) => (
              <li {...sx.components_SeoEvidence_li16}>
                <a {...sx.components_SeoEvidence_a17} href={link.href} rel={link.external ? "noopener" : undefined} target={link.external ? "_blank" : undefined}>
                  {link.label}{link.external ? " ↗" : ""}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</aside>
