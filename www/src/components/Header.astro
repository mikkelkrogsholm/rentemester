---
import { attributes as sx } from "../../.stylex/site-stylex";
import { SITE, NAV } from "../consts";
const pathname = Astro.url.pathname;
---

<header {...sx.components_Header_header1}>
  <div {...sx.components_Header_div2}>
    <a href="/" {...sx.components_Header_a3} aria-label={`${SITE.name} — forside`}>
      {SITE.name}
    </a>

    <nav {...sx.components_Header_nav4} aria-label="Hovedmenu">
      {NAV.map((item) => {
        const active = pathname === item.href || (item.href !== "/" && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            {...(active ? sx.components_Header_a5 : sx.components_Header_a6)}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div {...sx.components_Header_div7}>
      <a
        href={SITE.github}
        rel="noopener me"
        target="_blank"
        {...sx.components_Header_a8}
      >
        <svg {...sx.components_Footer_svg7} width="14" height="14" viewBox="0 0 16 16"  aria-hidden="true">
          <path {...sx.components_Footer_path8} d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        Se på GitHub
      </a>
      <button
        type="button"
        id="mobile-nav-toggle"
        {...sx.components_Header_button9}
        aria-label="Vis menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg {...sx.components_Header_svg10} width="20" height="20" viewBox="0 0 24 24"    aria-hidden="true">
          <line {...sx.components_Header_line11} x1="3" y1="6" x2="21" y2="6"/>
          <line {...sx.components_Header_line11} x1="3" y1="12" x2="21" y2="12"/>
          <line {...sx.components_Header_line11} x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    hidden
    {...sx.components_Header_nav12}
    aria-label="Mobil-menu"
  >
    <ul {...sx.components_Header_ul13}>
      {NAV.map((item) => (
        <li {...sx.components_Header_li14}>
          <a
            href={item.href}
            {...sx.components_Header_a15}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li {...sx.components_Header_li16}>
        <a
          href={SITE.github}
          rel="noopener me"
          target="_blank"
          {...sx.components_Header_a17}
        >
          GitHub →
        </a>
      </li>
    </ul>
  </nav>
</header>



<script is:inline>
  (() => {
    const btn = document.getElementById("mobile-nav-toggle");
    const nav = document.getElementById("mobile-nav");
    if (!btn || !nav) return;
    btn.addEventListener("click", () => {
      nav.hidden = !nav.hidden;
      btn.setAttribute("aria-expanded", String(!nav.hidden));
      btn.setAttribute("aria-label", nav.hidden ? "Vis menu" : "Luk menu");
    });
  })();
</script>
