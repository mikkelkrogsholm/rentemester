---
import { attributes as sx } from "../../.stylex/site-stylex";
import BaseLayout from "../layouts/BaseLayout.astro";
import SeoEvidence from "../components/SeoEvidence.astro";
import { SITE } from "../consts";

const faq = [
  {
    q: "Er Rentemester en service jeg kan købe?",
    a: "Nej. Rentemester er et open source projekt under MIT-licens. Der er ingen tilmelding, ingen pris, ingen hosted version. Du kloner repoet fra GitHub og kører det selv — lokalt på din maskine eller på en server du selv styrer.",
  },
  {
    q: "Hvem står bag?",
    a: `Rentemester er et fællesskabsdrevet projekt startet af ${SITE.author}. Alt arbejde sker offentligt på GitHub. Bidrag fra revisorer, bogholdere, udviklere og brugere er meget velkomne.`,
  },
  {
    q: "Hvorfor open source?",
    a: "Fordi bogføring er virksomhedens fundament — det skal ikke ligge bag en lukket betalingsmur, og du skal kunne verificere at reglerne er korrekte. Når kildekoden er åben, kan din revisor inspicere logikken og du beholder fuld kontrol over data.",
  },
  {
    q: "Kører det i skyen eller lokalt?",
    a: "Lokalt som default. Rentemester er et CLI-værktøj bygget på Bun og TypeScript med en SQLite-ledger. Du bestemmer selv hvor data ligger. Ingen telemetri, ingen cloud-afhængighed.",
  },
  {
    q: "Kan jeg bruge det til min ApS-bogføring i dag?",
    a: "Projektet er under aktiv udvikling. Tjek roadmap og issues på GitHub for status. Du er velkommen til at afprøve det, give feedback og bidrage med regler eller kode.",
  },
  {
    q: "Hvilken licens?",
    a: "MIT. Du kan frit bruge, ændre og distribuere koden — også kommercielt. Eneste krav er at licens og copyright bevares.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  titleOverride={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  datePublished="2026-05-18"
  dateModified="2026-05-19"
  reviewedBy={SITE.author}
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section {...sx.pages_index_section1}>
    <div {...sx.components_PageHero_div2}>
      <div {...sx.pages_index_div2}></div>
      <div {...sx.pages_index_div3}></div>
    </div>
    <div {...sx.pages_index_div4}>
      <div {...sx.components_PageHero_div5}>
        <div {...sx.pages_index_div5}>
          <span {...sx.pages_index_span6}>
            Open source · MIT
          </span>
          <span {...sx.pages_index_span7}>
            v0.0.1 · under udvikling
          </span>
        </div>

        <h1 {...sx.pages_index_h18}>
          En åben AI-bogholder<br {...sx.pages_index_br9}/>for dansk bogføring
        </h1>

        <p {...sx.pages_index_p10}>
          Rentemester er <strong {...sx.pages_index_strong11}>agent-first bogføring</strong> til danske freelancere, mikrovirksomheder og små ApS’er. En AI-agent kan gøre rutinearbejdet; danske regler som kode afgør hvad der må bogføres; en append-only ledger gør historikken efterprøvbar.
        </p>
        <p {...sx.pages_index_p12}>
          Det kan bruges <strong {...sx.pages_index_strong13}>på to måder</strong>: <strong {...sx.pages_index_strong13}>agent-betjent</strong>, hvor en autonom agent driver bogholderiet for dig, eller <strong {...sx.pages_index_strong13}>menneske-betjent</strong>, hvor du selv styrer hver kommando. Samme kerne, samme regler, samme reviderbare spor.
        </p>
        <p {...sx.pages_index_p14}>
          Ambitionen er rolig: et system der kan hjælpe med rutinerne, holde sig inden for eksplicitte regler og forklare hver eneste postering. Projektet er åbent, fordi tillid kræver gennemsigtighed.
        </p>

        <div {...sx.pages_index_div15}>
          <a
            href={SITE.github}
            rel="noopener me"
            target="_blank"
            {...sx.pages_index_a16}
          >
            <svg {...sx.components_Footer_svg7} width="16" height="16" viewBox="0 0 16 16"  aria-hidden="true">
              <path {...sx.components_Footer_path8} d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            Se projektet
          </a>
          <a
            href="#agent-brief"
            {...sx.pages_index_a17}
          >
            Lad din agent bidrage →
          </a>
        </div>

        <!-- Quick install snippet -->
        <div {...sx.pages_index_div18}>
          <div {...sx.pages_index_div19}>Klon og kør lokalt</div>
          <div {...sx.pages_index_div20} tabindex="0" role="region" aria-label="Klon og kør lokalt">
            <div {...sx.components_Footer_div9}><span {...sx.pages_index_span21}>$ </span><span {...sx.pages_index_span22}>git</span> clone {SITE.github}.git</div>
            <div {...sx.components_Footer_div9}><span {...sx.pages_index_span21}>$ </span><span {...sx.pages_index_span22}>cd</span> rentemester &amp;&amp; <span {...sx.pages_index_span22}>bun</span> install</div>
            <div {...sx.components_Footer_div9}><span {...sx.pages_index_span21}>$ </span><span {...sx.pages_index_span22}>bun</span> run src/cli.ts init --company ./min-virksomhed</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section {...sx.pages_index_section23}>
    <SeoEvidence
      sources={[
        { href: SITE.github, label: "GitHub-repository", external: true },
        { href: `${SITE.github}/blob/main/package.json`, label: "Test- og smoke-gates", external: true },
        { href: `${SITE.github}/tree/main/rules/dk`, label: "Danske regler som kode", external: true },
      ]}
      related={[
        { href: "/regnskabsprogram", label: "Regnskabsprogram" },
        { href: "/ai-bogholder", label: "AI-bogholder" },
        { href: "/viden", label: "Viden om dansk bogføring" },
      ]}
    />
  </section>

  <!-- OPEN SOURCE CALLOUT -->
  <section {...sx.pages_index_section24}>
    <div {...sx.pages_index_div25}>
      <div {...sx.pages_index_div26}>
        <div {...sx.pages_index_div27}>
          <div {...sx.pages_index_div28}>Læs først</div>
          <h2 {...sx.pages_index_h229}>Ikke SaaS. Ikke lock-in. Bare kildekode.</h2>
        </div>
        <div {...sx.pages_index_div30}>
          <p {...sx.pages_viden_regnskab_skatteopgoerelse_p2}>Rentemester er et <strong {...sx.pages_viden_frister_moms_strong1}>fællesskabsdrevet open source projekt</strong>. Ingen licenssalg, ingen SaaS-tilmelding, ingen skjult forretningsmodel. Alt foregår offentligt på GitHub under MIT-licens.</p>
          <p {...sx.pages_viden_regnskab_skatteopgoerelse_p2}>Du kan klone repoet, læse koden, køre systemet lokalt og åbne et issue eller en pull request når noget mangler. Projektet bliver stærkere jo flere der prøver reglerne af mod virkelige danske bilag.</p>
          <p {...sx.pages_viden_regnskab_skatteopgoerelse_p2}>Det betyder også: ingen telemetri, ingen cloud-afhængighed, ingen lock-in. Dine bogføringsdata er dine — i en lokal SQLite-fil du selv ejer.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- REJSEN MOD V1 -->
  <section id="roadmap" {...sx.pages_index_section31}>
    <div {...sx.pages_index_div32}>
      <div {...sx.pages_index_div33}>
        <div {...sx.pages_index_div28}>Rejsen mod v1</div>
        <h2 {...sx.pages_index_h234}>Et produkt med ro. Et projekt med puls.</h2>
        <p {...sx.pages_index_p35}>
          Bogholderi skal føles stabilt. Udviklingen må gerne være synlig. Derfor viser Rentemester både hvad der virker nu, hvad der er næste station, og hvad v1 skal kunne før nogen bør stole tungt på det.
        </p>
        <p {...sx.pages_index_p36}>
          Projektet begyndte natten til søndag. Roadmappet er ikke pynt — det er arbejdsfladen for udviklere, revisorer, bogholdere, brugere og agenter.
        </p>
      </div>

      <div {...sx.pages_index_div37} aria-label="Roadmap mod version 1">
        {[
          { status: "live", day: "Nat 0", title: "Første ledger", body: "CLI, SQLite, dobbelt bogholderi og testbar kerne." },
          { status: "live", day: "Dag 1", title: "Danske regler som kode", body: "Bilag, kontoplan, momslogik og valideringer får faste tests." },
          { status: "live", day: "Dag 2", title: "Faktura + bankafstemning", body: "Fakturaer, betalinger, rykkere, kreditnotaer, bankafstemning og valutakøb er nu dækket af tests og smoke-flow." },
          { status: "live", day: "Dag 2.5", title: "Agent-workflow + dashboard", body: "MCP-server, agent-demo, llms-brief og statisk HTML-dashboard gør projektet læsbart for både mennesker og agenter." },
          { status: "live", day: "Dag 2.8", title: "Bilagsmail og exception-kø", body: "Bilag kan ingest'es fra EML/maildrop og direkte fra en e-mailkonto via IMAP; usikre cases lander i exception-køen." },
          { status: "now", day: "Nu", title: "PEPPOL og stamdata", body: "EAN/GLN-preview, OIOUBL-handoff og gentagne fakturaskabeloner er landet. Næste skridt er direkte PEPPOL-transport og stærkere kunde-/leverandørstamdata." },
          { status: "live", day: "Dag 3", title: "Eksportspor til myndighed og revisor", body: "Authority export, første deterministiske SAF-T-slice og lokal accountant-handoff giver et konkret, verificerbart eksportlag uden at påstå fuld compliance eller hosted adgang." },
          { status: "future", day: "v0.5", title: "Interaktiv web-UI", body: "Det statiske dashboard skal vokse til et lille kontrolrum for godkendelser, exceptions og drill-down i ledgeren." },
          { status: "future", day: "v0.5", title: "Åbne bankfeeds og plugins", body: "CSV virker nu. Senere kommer PSD2/open banking og forsigtige integrationer til fx PayPal, Zettle og Shopify." },
          { status: "future", day: "v1", title: "Danmarks bedste bogholder", body: "Ikke fordi den gætter bedst. Fordi den arbejder mest disciplineret, dokumenterer alt og stopper når den bør." },
        ].map((stop) => (
          <article {...sx.pages_index_article38}>
            <div {...(stop.status === "live" ? sx.pages_index_div39_live : stop.status === "now" ? sx.pages_index_div40_now : stop.status === "next" ? sx.pages_index_div41_next : sx.pages_index_div42_future)} aria-hidden="true"></div>
            <div {...sx.pages_index_div43}>
              <div {...sx.pages_index_div44}>
                <span {...sx.pages_index_span45}>{stop.day}</span>
                <span {...sx.pages_index_span46}>{stop.status === "live" ? "bygget" : stop.status === "now" ? "i gang" : stop.status === "next" ? "næste" : "planlagt"}</span>
              </div>
              <h3 {...sx.pages_index_h347}>{stop.title}</h3>
              <p {...sx.pages_index_p48}>{stop.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- AGENT BRIEF -->
  <section id="agent-brief" {...sx.pages_index_section24}>
    <div {...sx.pages_index_div49}>
      <div {...sx.pages_index_div50}>
        <div {...sx.components_Footer_div9}>
          <div {...sx.pages_index_div28}>For agents</div>
          <h2 {...sx.pages_index_h251}>Peg din agent på projektet</h2>
          <p {...sx.pages_index_p52}>
            Rentemester skal kunne udvikles uden møder. En agent skal kunne læse siden, forstå målet, finde en åben station og levere en lille, testet forbedring.
          </p>
          <p {...sx.pages_index_p36}>
            Det er ikke et trick. Det er en måde at gøre open source praktisk igen: klare regler, små opgaver, acceptance criteria og tests før selvtillid.
          </p>
        </div>
        <div {...sx.pages_index_div53}>
          <div {...sx.components_Footer_div10}>Prompt til din agent</div>
          <pre tabindex="0" aria-label="Kodeeksempel" {...sx.pages_index_pre54}><code {...sx.pages_index_code55}>{`Læs https://rentemester.dk/llms.txt først. Den er altid den opdaterede agent-brief.

Læs derefter repoet: https://github.com/mikkelkrogsholm/rentemester

Målet er Danmarks bedste open source bogholder for små danske virksomheder.

Vælg én lille opgave fra roadmap, issues eller CONTRIBUTING.md.
Opfind aldrig danske bogføringsregler. Brug kilder, tests og eksisterende mønstre.

Lav en minimal ændring. Kør tests. Forklar hvad du ændrede, hvorfor det er sikkert, og hvad der stadig mangler.`}</code></pre>
          <div {...sx.pages_index_div56}>
            <a href={`${SITE.github}/blob/main/CONTRIBUTING.md`} rel="noopener" target="_blank" {...sx.pages_index_a57}>Bidragsguide ↗</a>
            <a href={`${SITE.github}/issues`} rel="noopener" target="_blank" {...sx.pages_index_a58}>Åbne opgaver ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- TRINITY: AGENT · REGLER · LEDGER -->
  <section {...sx.pages_index_section31}>
    <div {...sx.pages_index_div59}>
      <div {...sx.pages_index_div28}>Arkitektur</div>
      <h2 {...sx.pages_index_h260}>Tre lag der ikke kan snyde hinanden</h2>
      <p {...sx.pages_index_p61}>
        AI’en er assistenten, ikke dommeren. Hver postering går gennem versionerede danske regler og lander i en ledger der ikke kan overskrives — kun udvides.
      </p>
    </div>

    <div {...sx.pages_index_div62}>
      <article {...sx.pages_index_article63}>
        <div {...sx.pages_index_div64}>
          <div {...sx.pages_index_div65}>01 · Agent</div>
          <svg {...sx.pages_index_svg66} width="32" height="32" viewBox="0 0 24 24"    aria-hidden="true">
            <rect {...sx.pages_index_rect67} x="3" y="6" width="18" height="14" rx="2"/>
            <circle {...sx.pages_index_circle68} cx="8" cy="13" r="1.5" />
            <circle {...sx.pages_index_circle68} cx="16" cy="13" r="1.5" />
            <line {...sx.components_Header_line11} x1="12" y1="2" x2="12" y2="6"/>
            <circle {...sx.pages_index_circle68} cx="12" cy="2" r="1" />
          </svg>
        </div>
        <h3 {...sx.pages_index_h369}>Agenten handler</h3>
        <p {...sx.pages_index_p36}>
          Læser bilag, matcher banklinjer, foreslår konti og forbereder strukturerede handlinger. Når noget er uklart, stopper den og beder om beslutning.
        </p>
      </article>

      <article {...sx.pages_index_article70}>
        <div {...sx.pages_index_div64}>
          <div {...sx.pages_index_div71}>02 · Regler</div>
          <svg {...sx.pages_index_svg72} width="32" height="32" viewBox="0 0 24 24"    aria-hidden="true">
            <path {...sx.components_Footer_path8} d="M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z"/>
            <path {...sx.components_Footer_path8} d="M9 12l2 2 4-4"/>
          </svg>
        </div>
        <h3 {...sx.pages_index_h369}>Reglerne afgør</h3>
        <p {...sx.pages_index_p36}>
          Danske bogførings- og momsregler ligger som versioneret kode i <code {...sx.pages_index_code73}>rules/dk/</code>. De kan testes, læses og udfordres.
        </p>
      </article>

      <article {...sx.pages_index_article70}>
        <div {...sx.pages_index_div64}>
          <div {...sx.pages_index_div74}>03 · Ledger</div>
          <svg {...sx.pages_index_svg75} width="32" height="32" viewBox="0 0 24 24"    aria-hidden="true">
            <rect {...sx.pages_index_rect67} x="4" y="4" width="16" height="16" rx="1"/>
            <line {...sx.components_Header_line11} x1="4" y1="9" x2="20" y2="9"/>
            <line {...sx.components_Header_line11} x1="4" y1="14" x2="20" y2="14"/>
            <line {...sx.components_Header_line11} x1="9" y1="4" x2="9" y2="20"/>
          </svg>
        </div>
        <h3 {...sx.pages_index_h369}>Ledgeren husker</h3>
        <p {...sx.pages_index_p36}>
          Append-only kassebog med hash-kæde og valgfri ed25519-signering. Fejl rettes med modposter, og revisor kan verificere kæden.
        </p>
      </article>
    </div>
  </section>

  <!-- COCKPIT -->
  <section id="cockpit" {...sx.pages_index_section76}>
    <div {...sx.pages_index_div77}>
      <div {...sx.pages_index_div78}>
        <div {...sx.components_Footer_div9}>
          <div {...sx.pages_index_div28}>Cockpittet</div>
          <h2 {...sx.pages_index_h234}>En grafisk brugerflade — ikke kun terminal</h2>
          <p {...sx.pages_index_p79}>
            Rentemester har et lokalt <strong {...sx.pages_index_strong13}>cockpit</strong> — et web-baseret kontrolpanel der lever oven på samme ledger og samme regler som CLI'en. Hvis du foretrækker at klikke, behøver du ikke leve i terminalen.
          </p>
          <p {...sx.pages_index_p80}>
            Overblik, resultatopgørelse, balance, bilag, bank, fakturaer, moms og forpligtelser — alt sammen i en browser, og hver handling skriver tilbage i den samme append-only historik. CLI og cockpit er to ansigter på den samme bogholder.
          </p>
          <div {...sx.pages_index_div81}>
            <div {...sx.components_Footer_div9}><span {...sx.pages_index_span21}>$ </span><span {...sx.pages_index_span22}>bun</span> run src/cli.ts serve --workspace ./min-workspace</div>
            <div {...sx.components_Footer_div9}><span {...sx.pages_index_span21}>$ </span><span {...sx.pages_index_span22}>cd</span> app &amp;&amp; <span {...sx.pages_index_span22}>bun</span> install &amp;&amp; <span {...sx.pages_index_span22}>bun</span> run dev</div>
            <div {...sx.pages_index_div82}># åbn http://localhost:5319</div>
          </div>
          <a href="/docs" {...sx.pages_index_a83}>
            Se docs &amp; daglig brug →
          </a>
        </div>
        <div {...sx.pages_index_div84}>
          <div {...sx.pages_index_div85}>Hvad du finder i cockpittet</div>
          <ul {...sx.pages_index_ul86}>
            <li {...sx.pages_index_li87}><span {...sx.pages_index_span88}>→</span><span {...sx.layouts_BaseLayout_span8}><strong {...sx.pages_index_strong13}>Overblik</strong> — likviditet, åbne fakturaer, exceptions, næste momsfrist</span></li>
            <li {...sx.pages_index_li87}><span {...sx.pages_index_span88}>→</span><span {...sx.layouts_BaseLayout_span8}><strong {...sx.pages_index_strong13}>Bilag</strong> — søg, filtrér, åbn dokumenter direkte i browseren</span></li>
            <li {...sx.pages_index_li87}><span {...sx.pages_index_span88}>→</span><span {...sx.layouts_BaseLayout_span8}><strong {...sx.pages_index_strong13}>Bank</strong> — importér CSV og match transaktioner mod bilag &amp; fakturaer</span></li>
            <li {...sx.pages_index_li87}><span {...sx.pages_index_span88}>→</span><span {...sx.layouts_BaseLayout_span8}><strong {...sx.pages_index_strong13}>Fakturaer</strong> — udsted, send på e-mail, kreditnota og rykkere</span></li>
            <li {...sx.pages_index_li87}><span {...sx.pages_index_span88}>→</span><span {...sx.layouts_BaseLayout_span8}><strong {...sx.pages_index_strong13}>Moms &amp; forpligtelser</strong> — rubrikker, frister og status</span></li>
            <li {...sx.pages_index_li87}><span {...sx.pages_index_span88}>→</span><span {...sx.layouts_BaseLayout_span8}><strong {...sx.pages_index_strong13}>Posteringer</strong>, <strong {...sx.pages_index_strong13}>kontakter</strong> og indbygget hjælp</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FUNKTIONER -->
  <section {...sx.pages_index_section89}>
    <div {...sx.pages_index_div77}>
      <div {...sx.pages_index_div90}>
        <div {...sx.pages_index_div91}>
          <div {...sx.pages_index_div28}>Funktioner</div>
          <h2 {...sx.pages_index_h292}>Bygget til danske hverdagsbilag</h2>
        </div>
        <a href="/funktioner" {...sx.pages_index_a93}>
          Se alle funktioner →
        </a>
      </div>

      <div {...sx.pages_index_div94}>
        {[
          { t: "Bilagsmail", d: "Indlæs bilag fra .eml-filer/maildrop eller direkte fra en e-mailkonto via IMAP. Usikre cases lander i exception-køen." },
          { t: "Bankimport", d: "CSV-import fra danske banker. Deterministiske forslag til matchning af linjer med bilag." },
          { t: "Kontakter", d: "Kunde- og leverandørkartotek med opslag i CVR-registret. Roadmap: tættere kobling til køb og bilagshistorik." },
          { t: "Fakturering", d: "Udsted fakturaer, registrér rykkere, kompensation og renter, og send faktura/påmindelse på e-mail — fuldt sporbart i ledgeren. Gentagne fakturaskabeloner er live; direkte PEPPOL-transport er roadmap." },
          { t: "Valutakøb", d: "Bogfør køb i fx USD/EUR korrekt, også når banken trækker et DKK-beløb på kontoen." },
          { t: "Momsrapport", d: "Generér afstemningsgrundlag for momsperioden. Repræsentation og EU-servicekøb er testede flows." },
