---
import { attributes as sx } from "../../.stylex/site-stylex";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { SITE } from "../consts";

const steps = [
  {
    n: "01",
    t: "Bilag og banklinjer kommer ind",
    d: "Bilag kan sendes til en mail, importeres som filer, eller ingest'es via CLI. Bankudtog importeres som CSV fra de fleste danske banker. Alt lægges i et lokalt SQLite-bibliotek.",
  },
  {
    n: "02",
    t: "Agenten forsøger at forstå",
    d: "AI-agenten læser bilag, foreslår kontering, matcher banklinjer med fakturaer, og bygger journalposter. Hver foreslået handling er en struktureret operation — ikke fri tekst.",
  },
  {
    n: "03",
    t: "Reglerne valideres",
    d: "Hver journalpost køres gennem regler i rules/dk/. Reglerne tjekker dobbelt bogholderi, momslogik, kontotyper, perioder. Hvis noget ikke holder, stopper det her.",
  },
  {
    n: "04",
    t: "Du afgør tvivlsspørgsmål",
    d: "Når agenten ikke er sikker — eller når en regel kræver menneskelig vurdering — havner spørgsmålet i din opgaveliste. Du svarer, agenten fortsætter.",
  },
  {
    n: "05",
    t: "Ledgeren skriver det permanent",
    d: "Godkendte posteringer skrives append-only i ledgeren med tidsstempel og signatur. Intet slettes. Rettelser sker som modposter, ikke som overskrivninger.",
  },
  {
    n: "06",
    t: "Rapporter og eksport",
    d: "Momsrapport, dashboard, myndigheds-/audit-eksport og audit-verifikation. Output er deterministisk: samme data → samme rapport, bit for bit.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "Sådan virker Rentemester",
  inLanguage: "da",
  step: steps.map((s, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    name: s.t,
    text: s.d,
  })),
};
---

<BaseLayout
  title="Sådan virker Rentemesters bogføring"
  description="Sådan virker Rentemester: AI-agenten foreslår, danske regler validerer, og en append-only ledger bevarer revisionssporet."
  ogImage="/og-saadan-virker-det.png"
  pageType="Article"
  datePublished="2026-05-18"
  dateModified="2026-05-19"
  reviewedBy={SITE.author}
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Arkitektur"
    title="Sådan virker Rentemesters bogføring"
    lead="Tre lag der holder hinanden ærlige: en AI-agent der hjælper, danske regler der validerer, og en append-only ledger der husker. Her er flowet fra bilag til rapport."
  />

  <section {...sx.pages_saadanVirkerDet_section1}>
    <div {...sx.pages_saadanVirkerDet_div2}>
      {steps.map((s) => (
        <article {...sx.pages_saadanVirkerDet_article3}>
          <div {...sx.pages_saadanVirkerDet_div4}>Trin {s.n}</div>
          <h2 {...sx.pages_saadanVirkerDet_h25}>{s.t}</h2>
          <p {...sx.pages_index_p36}>{s.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section {...sx.pages_index_section89}>
    <div {...sx.pages_saadanVirkerDet_div6}>
      <h2 {...sx.pages_saadanVirkerDet_h27}>Det tekniske fundament</h2>
      <dl {...sx.pages_saadanVirkerDet_dl8}>
        <div {...sx.pages_vaerktoej_momsberegner_div4}>
          <dt {...sx.pages_saadanVirkerDet_dt9}>Sprog &amp; runtime</dt>
          <dd {...sx.pages_saadanVirkerDet_dd10}>TypeScript på Bun. Ingen Node-afhængigheder, ingen build-step for at køre. <code {...sx.pages_index_code73}>bun install</code> og du er kørende.</dd>
        </div>
        <div {...sx.pages_vaerktoej_momsberegner_div4}>
          <dt {...sx.pages_saadanVirkerDet_dt9}>Ledger</dt>
          <dd {...sx.pages_saadanVirkerDet_dd10}>SQLite, append-only. Hver postering er hashet og kædet til den forrige. Ledgeren signeres opt-in med ed25519, så en tredjepart kan verificere integriteten uden adgang til private nøgler.</dd>
        </div>
        <div {...sx.pages_vaerktoej_momsberegner_div4}>
          <dt {...sx.pages_saadanVirkerDet_dt9}>Regler</dt>
          <dd {...sx.pages_saadanVirkerDet_dd10}>Almindelige TypeScript-moduler i <code {...sx.pages_index_code73}>rules/dk/</code>. Læsbare for revisorer der kan kode bare lidt, testbare som almindelig kode, versionsstyrede via git.</dd>
        </div>
        <div {...sx.pages_vaerktoej_momsberegner_div4}>
          <dt {...sx.pages_saadanVirkerDet_dt9}>Agent</dt>
          <dd {...sx.pages_saadanVirkerDet_dd10}>Modelagnostisk. Eksponeres som MCP-server så kompatible klienter kan arbejde gennem en stram operations-protokol — ikke fri tekst ind i ledgeren.</dd>
        </div>
        <div {...sx.pages_vaerktoej_momsberegner_div4}>
          <dt {...sx.pages_saadanVirkerDet_dt9}>Output</dt>
          <dd {...sx.pages_saadanVirkerDet_dd10}>Dashboard som ren HTML (deterministisk render), myndigheds-/audit-eksport som JSON+CSV, og momsrapporter som struktureret afstemningsgrundlag.</dd>
        </div>
      </dl>

      <div {...sx.pages_saadanVirkerDet_div11}>
        <div {...sx.pages_index_div28}>Konkrete how-to-guides</div>
        <p {...sx.pages_saadanVirkerDet_p12}>
          Vil du se det i praksis? Docs-oversigten har korte guides til de almindeligste hverdagsflows — installation, første faktura, bank-import og momsangivelse.
        </p>
        <a href="/docs" {...sx.pages_index_a83}>
          Se docs &amp; daglig brug →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
