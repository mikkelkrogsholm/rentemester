---
import { attributes as sx } from "../../.stylex/site-stylex";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Siden findes ikke"
  description="Den side du leder efter findes ikke. Vend tilbage til forsiden eller dokumentationen."
  noindex={true}
>
  <section {...sx.pages_404_section1}>
    <div {...sx.pages_404_div2}>
      <div {...sx.components_PageHero_div6}>404</div>
      <h1 {...sx.pages_404_h13}>Ikke fundet</h1>
      <p {...sx.pages_404_p4}>
        Den side findes ikke — eller findes ikke endnu. Tilbage til forsiden eller søg i dokumentationen.
      </p>
      <div {...sx.pages_404_div5}>
        <a href="/" {...sx.pages_404_a6}>Til forsiden</a>
        <a href="/docs/installation" {...sx.pages_404_a7}>Dokumentation</a>
      </div>
    </div>
  </section>
</BaseLayout>
