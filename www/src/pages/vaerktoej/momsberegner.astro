---
import { attributes as sx } from "../../../.stylex/site-stylex";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SeoEvidence from "../../components/SeoEvidence.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Momsberegner",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "DKK" },
};

const skatMomssatsUrl = "https://info.skat.dk/data.aspx?oid=1921136";
---

<BaseLayout
  title="Momsberegner til dansk 25 procent moms"
  description="Gratis momsberegner til dansk 25 procent moms: beregn ekskl. moms, momsbeløb og inkl. moms begge veje med tydelig formel."
  pathname="/vaerktoej/momsberegner"
  pageType="SoftwareApplication"
  datePublished="2026-05-19"
  dateModified="2026-05-19"
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Værktøj"
    title="Momsberegner"
    lead="Beregn dansk 25 procent moms begge veje: fra ekskl. moms til inkl. moms, eller fra inkl. moms til momsbeløb og nettopris."
  />

  <section {...sx.pages_viden_index_section1}>
    <div {...sx.pages_vaerktoej_momsberegner_div1}>
      <div {...sx.pages_vaerktoej_momsberegner_div2}>
        <form id="vat-calculator" {...sx.pages_vaerktoej_momsberegner_form3}>
          <div {...sx.pages_vaerktoej_momsberegner_div4}>
            <label for="amount" {...sx.pages_vaerktoej_momsberegner_label5}>Beløb</label>
            <input id="amount" name="amount" inputmode="decimal" value="1000" {...sx.pages_vaerktoej_momsberegner_input6} />
          </div>
          <fieldset {...sx.pages_vaerktoej_momsberegner_fieldset7}>
            <legend {...sx.pages_vaerktoej_momsberegner_legend8}>Beløbet er</legend>
            <div {...sx.components_KnowledgeSectionLinks_div3}>
              <label {...sx.pages_vaerktoej_momsberegner_label9}>
                <input {...sx.pages_vaerktoej_momsberegner_input10} type="radio" name="mode" value="ex" checked />
                <span {...sx.layouts_BaseLayout_span8}>Ekskl. moms</span>
              </label>
              <label {...sx.pages_vaerktoej_momsberegner_label9}>
                <input {...sx.pages_vaerktoej_momsberegner_input10} type="radio" name="mode" value="inc" />
                <span {...sx.layouts_BaseLayout_span8}>Inkl. moms</span>
              </label>
            </div>
          </fieldset>
        </form>

        <div {...sx.pages_vaerktoej_momsberegner_div11} aria-live="polite">
          <div {...sx.pages_vaerktoej_momsberegner_div12}>
            <div {...sx.pages_vaerktoej_momsberegner_div13}>Ekskl. moms</div>
            <div id="result-net" {...sx.pages_vaerktoej_momsberegner_div14}>1.000,00 kr.</div>
          </div>
          <div {...sx.pages_vaerktoej_momsberegner_div12}>
            <div {...sx.pages_vaerktoej_momsberegner_div13}>Moms</div>
            <div id="result-vat" {...sx.pages_vaerktoej_momsberegner_div15}>250,00 kr.</div>
          </div>
          <div {...sx.pages_vaerktoej_momsberegner_div12}>
            <div {...sx.pages_vaerktoej_momsberegner_div13}>Inkl. moms</div>
            <div id="result-gross" {...sx.pages_vaerktoej_momsberegner_div14}>1.250,00 kr.</div>
          </div>
        </div>
      </div>

      <article {...sx.pages_vaerktoej_momsberegner_article16}>
        <h2 {...sx.pages_viden_regnskab_skatteopgoerelse_h23}>Sådan regner du dansk moms</h2>
        <p {...sx.pages_viden_regnskab_skatteopgoerelse_p2}>Den normale danske momssats er 25 procent. Fra nettopris til bruttopris lægger du 25 procent til. Fra bruttopris til momsbeløb udgør momsen 20 procent af beløbet inklusiv moms. Kilden er <a {...sx.pages_viden_saadanBogfoererDu_udlaeg_a1} href={skatMomssatsUrl} rel="noopener" target="_blank">Skattestyrelsens juridiske vejledning om momssatsen</a>.</p>
        <h3 {...sx.pages_viden_fakturering_eFakturaOffentlig_h31}>Eksempel</h3>
        <p {...sx.pages_viden_regnskab_skatteopgoerelse_p2}>1.000 kr. ekskl. moms bliver 1.250 kr. inkl. moms. Momsen er 250 kr.</p>
        <h3 {...sx.pages_viden_fakturering_eFakturaOffentlig_h31}>Formler</h3>
        <ul {...sx.pages_viden_saadanBogfoererDu_leverandoerfaktura_ul1}>
          <li {...sx.pages_viden_saadanBogfoererDu_leverandoerfaktura_li2}>Pris inkl. moms = pris ekskl. moms × 1,25</li>
          <li {...sx.pages_viden_saadanBogfoererDu_leverandoerfaktura_li2}>Momsbeløb = pris ekskl. moms × 0,25</li>
          <li {...sx.pages_viden_saadanBogfoererDu_leverandoerfaktura_li2}>Pris ekskl. moms = pris inkl. moms / 1,25</li>
          <li {...sx.pages_viden_saadanBogfoererDu_leverandoerfaktura_li2}>Momsbeløb i en bruttopris = pris inkl. moms × 0,20</li>
        </ul>
        <h3 {...sx.pages_viden_fakturering_eFakturaOffentlig_h31}>Hvornår er den ikke nok?</h3>
        <p {...sx.pages_viden_regnskab_skatteopgoerelse_p2}>Beregneren dækker almindelig 25 procent dansk moms. Brug ikke resultatet ukritisk til momsfritagelser, EU reverse charge, repræsentation, delvist fradrag, importmoms eller blandet privat/erhverv.</p>
        <h3 {...sx.pages_viden_fakturering_eFakturaOffentlig_h31}>Hvorfor 20 procent af bruttoprisen?</h3>
        <p {...sx.pages_viden_regnskab_skatteopgoerelse_p2}>Når en pris allerede indeholder 25 procent moms, er bruttoprisen 125 procent af nettoprisen. Momsdelen er derfor 25 ud af 125, altså 20 procent af bruttobeløbet. Det er den fejl mange laver, når de forsøger at trække 25 procent fra en pris inklusiv moms.</p>
        <h3 {...sx.pages_viden_fakturering_eFakturaOffentlig_h31}>Praktisk brug</h3>
        <p {...sx.pages_viden_regnskab_skatteopgoerelse_p2}>Brug beregneren til hurtige kontroller af fakturalinjer, tilbud, kvitteringer og små regneeksempler. Ved bogføring skal beløbet stadig passe med bilaget, momskoden og den konkrete fradragsret.</p>
        <p {...sx.pages_viden_regnskab_skatteopgoerelse_p2}>Læs også <a {...sx.pages_viden_saadanBogfoererDu_udlaeg_a1} href="/viden/moms/satser">momssatser i Danmark</a> og <a {...sx.pages_viden_saadanBogfoererDu_udlaeg_a1} href="/viden/frister/moms">momsfrister</a>.</p>
      </article>
    </div>
    <SeoEvidence
      sources={[
        { href: skatMomssatsUrl, label: "Skattestyrelsen: momssatsen", external: true },
        { href: "https://www.retsinformation.dk/eli/lta/2024/209", label: "Momsloven § 33", external: true },
      ]}
      related={[
        { href: "/viden/moms/satser", label: "Momssatser i Danmark" },
        { href: "/viden/frister/moms", label: "Momsfrister" },
        { href: "/regnskabsprogram", label: "Regnskabsprogram" },
      ]}
    />
  </section>

  <script is:inline>
    (() => {
      const amount = document.getElementById("amount");
      const net = document.getElementById("result-net");
      const vat = document.getElementById("result-vat");
      const gross = document.getElementById("result-gross");
      const fmt = new Intl.NumberFormat("da-DK", { style: "currency", currency: "DKK" });
      const parse = (value) => {
        const normalized = String(value).trim().replace(/\./g, "").replace(",", ".");
        const number = Number(normalized);
        return Number.isFinite(number) ? number : 0;
      };
      const update = () => {
        const mode = document.querySelector('input[name="mode"]:checked')?.value ?? "ex";
        const input = parse(amount.value);
        const netValue = mode === "ex" ? input : input / 1.25;
        const grossValue = mode === "ex" ? input * 1.25 : input;
        const vatValue = grossValue - netValue;
        net.textContent = fmt.format(netValue);
        vat.textContent = fmt.format(vatValue);
        gross.textContent = fmt.format(grossValue);
      };
      document.getElementById("vat-calculator")?.addEventListener("input", update);
      update();
    })();
  </script>
</BaseLayout>
